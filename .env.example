# ── LLM — Anthropic (critic & chooser) ──────────────────────────────────────
# The critic evaluates beam-search windows at checkpoints; Haiku is fast and
# economical for this. Swap to a more capable model if quality is lacking.
ANTHROPIC_API_KEY=

SHPOET_LLM_MODEL=claude-haiku-4-5-20251001
SHPOET_USE_CRITIC=true
SHPOET_USE_CHOOSER=false


# ── Embeddings ───────────────────────────────────────────────────────────────
# Choose one provider. Set the matching API key; the other can be left blank.

SHPOET_EMBEDDING_PROVIDER=openai          # openai | voyage

# OpenAI — default model. SHPOET_EMBEDDING_DIMENSIONS must match the model.
OPENAI_API_KEY=
SHPOET_EMBEDDING_MODEL=text-embedding-3-large
SHPOET_EMBEDDING_DIMENSIONS=3072

# Voyage AI — uncomment and adjust if switching provider.
# SHPOET_EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=
# SHPOET_EMBEDDING_MODEL=voyage-3-large
# SHPOET_EMBEDDING_DIMENSIONS=1024


# ── Storage ──────────────────────────────────────────────────────────────────
# Use file paths for persistence across server restarts.
SHPOET_DB_PATH=data/shakespeare_poet.db
SHPOET_OUTPUT_DIR=data/output
SHPOET_PROCESSED_DIR=data/processed
